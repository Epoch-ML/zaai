{
  "name": "analytics-platform-js",
  "version": "1.0.0",
  "description": "A comprehensive data analytics platform built with JavaScript/TypeScript",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.js",
    "build": "tsc",
    "clean": "rm -rf dist coverage"
  },
  "keywords": [
    "analytics",
    "data-processing",
    "visualization",
    "etl",
    "pipeline"
  ],
  "author": "Analytics Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "lodash": "^4.17.21",
    "axios": "^1.6.0",
    "csv-parser": "^3.0.0",
    "xml2js": "^0.6.2",
    "uuid": "^9.0.0",
    "yargs": "^17.7.2",
    "winston": "^3.11.0",
    "dotenv": "^16.3.1",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "@types/node": "^20.10.0",
    "@types/express": "^4.17.21",
    "@types/lodash": "^4.14.202",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.10",
    "ts-node": "^10.9.1",
    "nodemon": "^3.0.2",
    "eslint": "^8.55.0",
    "@babel/core": "^7.23.5",
    "@babel/preset-env": "^7.23.5"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.js",
      "**/?(*.)+(spec|test).js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/example/analytics-platform-js"
  }
}