{# Basic Test Function Template #}
{# This template generates a Python test function with variable substitution #}
def test_simple_template_rendering(zerg_state=None):
    """
    Test that demonstrates simple template rendering with context variables.
    Generated for user: {{ user_name | default('Guest') }}
    Environment: {{ environment | upper }}
    """
    print("=" * 40)
    {% if report_title is defined %}
    print("{{ report_title }}")
    {% else %}
    print("Welcome Message Test")
    {% endif %}
    print("=" * 40)
    
    # Test configuration
    user_name = "{{ user_name | default('Guest') }}"
    environment = "{{ environment | upper }}"
    timestamp = "{{ timestamp | default('Not specified') }}"
    
    print(f"Hello {user_name}!")
    print(f"Environment: {environment}")
    print(f"Timestamp: {timestamp}")
    
    {% if custom_message is defined %}
    # Custom message from template context
    custom_message = "{{ custom_message }}"
    print(f"Custom Message: {custom_message}")
    assert custom_message, "Custom message should be defined"
    {% endif %}
    
    {% if connector_name is defined %}
    # Auto-context values
    connector_name = "{{ connector_name }}"
    module_name = "{{ connector_name_lower }}"
    print(f"Connector: {connector_name}")
    print(f"Module: {module_name}")
    
    # Verify auto-context worked
    assert connector_name, "Connector name should be set by auto_context"
    assert module_name == connector_name.lower(), "Module name should be lowercase connector name"
    {% endif %}
    
    {% if app_name is defined %}
    app_name = "{{ app_name }}"
    print(f"Application: {app_name}")
    assert app_name, "App name should be defined"
    {% endif %}
    
    {% if test_count is defined and test_count > 0 %}
    test_count = {{ test_count }}
    print(f"Number of tests configured: {test_count}")
    assert test_count > 0, "Test count should be positive"
    {% endif %}
    
    print("-" * 40)
    
    # Environment-specific assertions
    {% if user_name == "Test User" %}
    print("This is a test execution!")
    assert user_name == "Test User", "Expected test user"
    is_test_mode = True
    {% else %}
    print("This is a production execution.")
    is_test_mode = False
    {% endif %}
    
    # Define greeting styles
    greeting_styles = [
    {% for style in ['Warm', 'Friendly', 'Professional'] %}
        "{{ style }}",
    {% endfor %}
    ]
    
    print("Available greeting styles:")
    for style in greeting_styles:
        print(f"  - {style} greeting")
    
    # Perform test assertions
    assert user_name, "User name should be defined"
    assert environment in ["TESTING", "PRODUCTION", "DEVELOPMENT"], f"Invalid environment: {environment}"
    assert len(greeting_styles) == 3, "Should have exactly 3 greeting styles"
    
    # Additional validations based on context
    {% if environment == "testing" %}
    assert environment == "TESTING", "Environment should be TESTING"
    {% endif %}
    
    {% if timestamp != "Not specified" %}
    # Validate timestamp format if provided
    assert "T" in timestamp or "/" in timestamp or "-" in timestamp, "Timestamp should be in valid format"
    {% endif %}
    
    print("=" * 40)
    print("Test completed successfully")
    print("=" * 40)
    
    return True