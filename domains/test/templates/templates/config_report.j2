{# Configuration Report Test Template #}
{# This template generates a Python test function that validates configuration values #}
def test_configuration_report(zerg_state=None):
    """
    Test that validates configuration values from the manifest.
    Generated By: {{ generated_by | default('Unknown') }}
    
    This test processes the 'configs' section passed via context_from directive
    and performs validation on each configuration item.
    """
    import re
    from datetime import datetime
    
    print("=" * 80)
    print("{{ report_title | default('Configuration Report') }}".center(80))
    print("=" * 80)
    
    generated_by = "{{ generated_by | default('Unknown') }}"
    timestamp = "{{ timestamp | default(datetime.now().isoformat()) }}"
    
    print(f"Generated By: {generated_by}")
    print(f"Generated At: {timestamp}")
    print()
    
    {% if configs is defined and configs | length > 0 %}
    # Configuration data from manifest
    configs = [
        {% for config in configs %}
        {
            "name": "{{ config.name }}",
            "description": "{{ config.description | default('No description provided') }}",
            {% if config.value is defined %}
            {% if config.value is string and config.value.startswith('<ENV_') %}
            "value": None,  # Environment variable not set
            "env_var_missing": True,
            {% elif 'password' in config.name.lower() or 'token' in config.name.lower() or 'key' in config.name.lower() %}
            "value": "[REDACTED]",
            "is_secret": True,
            {% else %}
            "value": {{ config.value | tojson }},
            {% endif %}
            {% else %}
            "value": None,
            {% endif %}
            "required": {{ 'True' if config.required else 'False' }},
            {% if config.notes is defined %}
            "notes": "{{ config.notes }}",
            {% endif %}
        },
        {% endfor %}
    ]
    
    print("Configuration Settings")
    print("-" * 22)
    print()
    
    # Validate each configuration
    validation_errors = []
    secret_configs = []
    
    for idx, config in enumerate(configs, 1):
        print(f"{idx}. {config['name'].upper()}")
        print(f"   Description: {config['description']}")
        
        # Check for environment variables
        if config.get('env_var_missing'):
            print(f"   Value: [Environment Variable Not Set]")
            if config['required']:
                validation_errors.append(f"{config['name']}: Required environment variable not set")
        elif config.get('is_secret'):
            print(f"   Value: [REDACTED]")
            secret_configs.append(config['name'])
        elif config['value'] is not None:
            print(f"   Value: {config['value']}")
        else:
            print(f"   Value: [Not Set]")
            if config['required']:
                validation_errors.append(f"{config['name']}: Required value not set")
        
        print(f"   Required: {'Yes' if config['required'] else 'No'}")
        
        if 'notes' in config:
            print(f"   Notes: {config['notes']}")
        
        print()
        
        # Perform type-specific validations
        if config['value'] is not None and not config.get('is_secret'):
            # Validate URLs
            if 'url' in config['name'].lower() or 'endpoint' in config['name'].lower():
                if isinstance(config['value'], str):
                    url_pattern = r'^https?://'
                    if not re.match(url_pattern, config['value']):
                        validation_errors.append(f"{config['name']}: Invalid URL format")
            
            # Validate timeouts
            if 'timeout' in config['name'].lower() or 'ttl' in config['name'].lower():
                if isinstance(config['value'], (int, float)):
                    if config['value'] <= 0:
                        validation_errors.append(f"{config['name']}: Timeout must be positive")
            
            # Validate retry counts
            if 'retry' in config['name'].lower() or 'retries' in config['name'].lower():
                if isinstance(config['value'], int):
                    if config['value'] < 0:
                        validation_errors.append(f"{config['name']}: Retry count cannot be negative")
            
            # Validate log levels
            if 'log_level' in config['name'].lower():
                valid_levels = ['DEBUG', 'INFO', 'WARNING', 'ERROR', 'CRITICAL']
                if config['value'] not in valid_levels:
                    validation_errors.append(f"{config['name']}: Invalid log level")
    
    # Summary Statistics
    print("Summary Statistics")
    print("-" * 18)
    
    total_configs = len(configs)
    required_configs = sum(1 for c in configs if c['required'])
    optional_configs = total_configs - required_configs
    
    print(f"Total Configurations: {total_configs}")
    print(f"Required Configurations: {required_configs}")
    print(f"Optional Configurations: {optional_configs}")
    print()
    
    # Assertions for test validation
    assert total_configs == {{ configs | length }}, "Config count mismatch"
    assert required_configs == {{ configs | selectattr('required', 'defined') | selectattr('required', 'equalto', true) | list | length }}, "Required config count mismatch"
    
    # Security Notice
    if secret_configs:
        print("Security Notice")
        print("-" * 15)
        print(f"This configuration contains {len(secret_configs)} sensitive field(s):")
        for secret_field in secret_configs:
            print(f"  - {secret_field}")
        print("Please ensure these values are properly secured.")
        print()
    
    # Report validation errors
    if validation_errors:
        print("Validation Errors")
        print("-" * 17)
        for error in validation_errors:
            print(f"  ⚠ {error}")
        print()
        
        # In test mode, we might want to fail on validation errors
        if generated_by == "j2_template_demo":
            print("Note: Validation errors detected but not failing test in demo mode")
    
    {% else %}
    # No configurations defined
    configs = []
    print("No configurations defined.")
    print()
    
    # This might be an error condition
    assert False, "No configurations were passed to the template"
    {% endif %}
    
    {% if additional_notes is defined %}
    print("Additional Notes")
    print("-" * 16)
    print("{{ additional_notes }}")
    print()
    {% endif %}
    
    print("=" * 80)
    print("End of Configuration Report")
    print("=" * 80)
    
    # Final test assertions
    {% if configs is defined and configs | length > 0 %}
    assert len(configs) > 0, "Should have at least one configuration"
    
    # Check that all required fields have values (except env vars)
    for config in configs:
        if config['required'] and not config.get('env_var_missing'):
            assert config['value'] is not None or config.get('is_secret'), \
                f"Required config '{config['name']}' must have a value"
    
    print("\n✓ Configuration validation test passed")
    {% endif %}
    
    return True