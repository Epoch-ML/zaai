{# Comprehensive Test Function Template #}
{# This template demonstrates usage of all YAML directive-generated values #}

def test_comprehensive_directives(zerg_state=None):
    """
    Comprehensive test demonstrating all YAML directives in action.
    
    This test validates that all directive-generated values are properly
    loaded and accessible through the template context.
    
    Generated at: {{ config.timestamp_iso }}
    Test ID: {{ config.session_id }}
    """
    import json
    import base64
    from datetime import datetime
    
    print("=" * 80)
    print("YAML DIRECTIVES COMPREHENSIVE TEST")
    print("=" * 80)
    
    # Basic Configuration
    print("\n[BASIC CONFIGURATION]")
    report_title = "{{ config.report_title }}"
    user_name = "{{ config.user_name | default('anonymous') }}"
    custom_message = "{{ config.custom_message }}"
    print(f"Report Title: {report_title}")
    print(f"User: {user_name}")
    print(f"Message: {custom_message}")
    
    # Time-related Directives
    print("\n[TIME DIRECTIVES]")
    timestamps = {
        "iso": "{{ config.timestamp_iso }}",
        "unix": {{ config.timestamp_unix | default(0) }},
        "date": "{{ config.timestamp_date }}",
        "datetime": "{{ config.timestamp_datetime }}",
        "custom": "{{ config.timestamp_custom }}",
        "today": "{{ config.today }}",
        "tomorrow": "{{ config.tomorrow }}",
        "last_week": "{{ config.last_week }}",
        "in_two_hours": "{{ config.in_two_hours }}"
    }
    
    for key, value in timestamps.items():
        print(f"  {key:15} : {value}")
    
    # Validate Unix timestamp is numeric
    assert isinstance(timestamps["unix"], int), "Unix timestamp should be an integer"
    
    # UUID Directives
    print("\n[UUID DIRECTIVES]")
    session_id = "{{ config.session_id }}"
    trace_id = "{{ config.trace_id }}"
    short_id = "{{ config.short_id }}"
    
    print(f"  Session ID (v4) : {session_id}")
    print(f"  Trace ID (v1)   : {trace_id}")
    print(f"  Short ID        : {short_id}")
    
    # Validate UUID formats
    assert len(session_id) == 36, f"UUID v4 should be 36 chars, got {len(session_id)}"
    assert len(trace_id) == 36, f"UUID v1 should be 36 chars, got {len(trace_id)}"
    assert len(short_id) == 8, f"Short UUID should be 8 chars, got {len(short_id)}"
    assert all(c in '-0123456789abcdef' for c in session_id.lower()), "Invalid UUID v4 format"
    
    # Random Value Directives
    print("\n[RANDOM VALUE DIRECTIVES]")
    random_values = {
        "port": {{ config.random_port }},
        "integer": {{ config.random_int }},
        "float": {{ config.random_float }},
        "choice": "{{ config.random_choice }}",
        "string": "{{ config.random_string }}",
        "hex": "{{ config.random_hex }}"
    }
    
    for key, value in random_values.items():
        print(f"  {key:10} : {value}")
    
    # Validate random values
    assert 1024 <= random_values["port"] <= 65535, f"Port {random_values['port']} out of range"
    assert 1 <= random_values["integer"] <= 100, f"Random int {random_values['integer']} out of range"
    assert 0 <= random_values["float"] <= 1, f"Random float {random_values['float']} out of range"
    assert random_values["choice"] in ["development", "staging", "production"], "Invalid environment choice"
    assert len(random_values["string"]) == 12, f"Random string should be 12 chars, got {len(random_values['string'])}"
    assert len(random_values["hex"]) == 16, f"Random hex should be 16 chars, got {len(random_values['hex'])}"
    assert all(c in '0123456789abcdef' for c in random_values["hex"].lower()), "Invalid hex string"
    
    # Security Directives
    print("\n[SECURITY DIRECTIVES]")
    api_key = "{{ config.api_key }}"
    auth_token = "{{ config.auth_token }}"
    temp_password = "{{ config.temp_password }}"
    
    print(f"  API Key        : {api_key[:10]}...{api_key[-4:]}")  # Partially masked
    print(f"  Auth Token     : {auth_token[:8]}...{auth_token[-4:]}")  # Partially masked
    print(f"  Temp Password  : {'*' * len(temp_password)}")  # Fully masked
    
    # Validate security tokens
    assert api_key.startswith("sk_"), f"API key should start with 'sk_', got {api_key[:3]}"
    assert len(auth_token) == 64, f"Auth token should be 64 chars (32 bytes hex), got {len(auth_token)}"
    assert len(temp_password) == 16, f"Temp password should be 16 chars, got {len(temp_password)}"
    
    # Hash Directives
    print("\n[HASH DIRECTIVES]")
    hashes = {
        "MD5": "{{ config.config_hash_md5 }}",
        "SHA256": "{{ config.config_hash_sha256 }}",
        "SHA1": "{{ config.config_hash_sha1 }}"
    }
    
    for algo, hash_value in hashes.items():
        print(f"  {algo:7} : {hash_value}")
    
    # Validate hash lengths
    assert len(hashes["MD5"]) == 32, f"MD5 should be 32 chars, got {len(hashes['MD5'])}"
    assert len(hashes["SHA256"]) == 64, f"SHA256 should be 64 chars, got {len(hashes['SHA256'])}"
    assert len(hashes["SHA1"]) == 40, f"SHA1 should be 40 chars, got {len(hashes['SHA1'])}"
    
    # Base64 Directives
    print("\n[BASE64 DIRECTIVES]")
    encoded_message = "{{ config.encoded_message }}"
    encoded_config = "{{ config.encoded_config }}"
    
    print(f"  Encoded Message : {encoded_message}")
    print(f"  Encoded Config  : {encoded_config}")
    
    # Decode and verify
    try:
        decoded_message = base64.b64decode(encoded_message).decode('utf-8')
        print(f"  Decoded Message : {decoded_message}")
        assert decoded_message == "Hello, Template World!", "Base64 decode mismatch"
    except Exception as e:
        print(f"  Failed to decode message: {e}")
    
    # Evaluation Directives
    print("\n[EVALUATION DIRECTIVES]")
    calculated_value = {{ config.calculated_value }}
    string_length = {{ config.string_length }}
    joined_string = "{{ config.joined_string }}"
    
    print(f"  2^8 Calculation : {calculated_value}")
    print(f"  String Length   : {string_length}")
    print(f"  Joined String   : {joined_string}")
    
    # Validate evaluated values
    assert calculated_value == 256, f"2^8 should be 256, got {calculated_value}"
    assert string_length == 16, f"Length of 'template_testing' should be 16, got {string_length}"
    assert joined_string == "test-template-v1", f"Joined string mismatch: {joined_string}"
    
    # ============================================
    # LIST DIRECTIVE TESTS WITH LOOPS
    # ============================================
    print("\n[LIST DIRECTIVES WITH LOOPS]")
    
    # Server list
    server_list = {{ config.server_list }}
    print(f"  Server List     : {server_list}")
    assert isinstance(server_list, list), "server_list should be a list"
    assert len(server_list) == 3, f"server_list should have 3 items, got {len(server_list)}"
    
    # Loop through server list
    print("  Iterating through servers:")
    {% for server in config.server_list %}
    print(f"    - Server #{{ loop.index }}: {{ server }}")
    {% endfor %}
    
    # Port list
    port_list = {{ config.port_list }}
    print(f"\n  Port List       : {port_list}")
    assert isinstance(port_list, list), "port_list should be a list"
    assert len(port_list) == 4, f"port_list should have 4 items, got {len(port_list)}"
    
    # Loop through ports with enumeration
    print("  Available ports:")
    {% for port in config.port_list %}
    print(f"    Port {{ loop.index0 }}: {{ port }}")
    {% endfor %}
    
    # Single item list
    single_list = {{ config.single_item_list }}
    print(f"\n  Single Item List: {single_list}")
    assert isinstance(single_list, list), "single_item_list should be a list"
    assert len(single_list) == 1, f"single_item_list should have 1 item, got {len(single_list)}"
    
    # Loop through single item (demonstrates loop works with 1 item)
    {% for item in config.single_item_list %}
    print(f"    Single item: {{ item }}")
    {% endfor %}
    
    # Empty list
    empty_list = {{ config.empty_list }}
    print(f"\n  Empty List      : {empty_list}")
    assert isinstance(empty_list, list), "empty_list should be a list"
    assert len(empty_list) == 0, f"empty_list should be empty, got {len(empty_list)}"
    
    # Loop through empty list (demonstrates loop handles empty)
    {% for item in config.empty_list %}
    print(f"    This should not print: {{ item }}")
    {% else %}
    print(f"    Empty list - no items to iterate")
    {% endfor %}
    
    # ============================================
    # DICT DIRECTIVE TESTS WITH LOOPS
    # ============================================
    print("\n[DICT DIRECTIVES WITH LOOPS]")
    
    # Server config dict
    server_config = {{ config.server_config }}
    print(f"  Server Config   : {server_config}")
    assert isinstance(server_config, dict), "server_config should be a dict"
    
    # Loop through server config keys and values
    print("  Server configuration details:")
    {% for key, value in config.server_config.items() %}
    print(f"    {{ key }}: {{ value }}")
    {% endfor %}
    
    # JSON config dict
    json_config = {{ config.json_config }}
    print(f"\n  JSON Config     : {json_config}")
    assert isinstance(json_config, dict), "json_config should be a dict"
    
    # Loop through JSON config with type checking
    print("  JSON configuration breakdown:")
    {% for key, value in config.json_config.items() %}
    print(f"    - {{ key }} = {{ value }} (type: {type({{ value }}).__name__})")
    {% endfor %}
    
    # Pairs config dict
    pairs_config = {{ config.pairs_config }}
    print(f"\n  Pairs Config    : {pairs_config}")
    assert isinstance(pairs_config, dict), "pairs_config should be a dict"
    
    # Loop through pairs config - useful for credentials/settings
    print("  Credentials and settings:")
    {% for key, value in config.pairs_config.items() %}
    {% if 'password' in key.lower() %}
    print(f"    {{ key }}: {'*' * len('{{ value }}')} [REDACTED]")
    {% else %}
    print(f"    {{ key }}: {{ value }}")
    {% endif %}
    {% endfor %}
    
    # Empty dict
    empty_dict = {{ config.empty_dict }}
    print(f"\n  Empty Dict      : {empty_dict}")
    assert isinstance(empty_dict, dict), "empty_dict should be a dict"
    assert len(empty_dict) == 0, f"empty_dict should be empty, got {len(empty_dict)}"
    
    # Loop through empty dict
    {% for key, value in config.empty_dict.items() %}
    print(f"    This should not print: {{ key }}={{ value }}")
    {% else %}
    print(f"    Empty dict - no items to iterate")
    {% endfor %}
    
    # ============================================
    # ADVANCED: NESTED LOOPS AND CONDITIONAL PROCESSING
    # ============================================
    print("\n[ADVANCED LIST/DICT PROCESSING]")
    
    # Create a mapping of servers to ports
    print("  Server-Port Mapping:")
    {% for server in config.server_list %}
    {% if loop.index0 < config.port_list|length %}
    print(f"    {{ server }} -> Port {{ config.port_list[loop.index0] }}")
    {% else %}
    print(f"    {{ server }} -> Port not assigned")
    {% endif %}
    {% endfor %}
    
    # Process all configs that are lists
    print("\n  All List Configurations:")
    list_configs = []
    {% for name, value in config.items() %}
    {% if value is sequence and value is not string %}
    list_configs.append(("{{ name }}", {{ value }}))
    print(f"    - {{ name }}: {{ value|length }} items")
    {% endif %}
    {% endfor %}
    
    # Process all configs that are dicts
    print("\n  All Dict Configurations:")
    dict_configs = []
    {% for name, value in config.items() %}
    {% if value is mapping %}
    dict_configs.append(("{{ name }}", {{ value }}))
    print(f"    - {{ name }}: {{ value.keys()|list }}")
    {% endif %}
    {% endfor %}
    
    # ============================================
    # REF DIRECTIVE TESTS
    # ============================================
    print("\n[REF DIRECTIVES]")
    
    # Referenced values
    base_url = "{{ config.base_url }}"
    api_version = "{{ config.api_version }}"
    referenced_base_url = "{{ config.referenced_base_url }}"
    referenced_user = "{{ config.referenced_user }}"
    referenced_port = "{{ config.referenced_port }}"
    
    print(f"  Base URL (original)    : {base_url}")
    print(f"  Base URL (referenced)  : {referenced_base_url}")
    assert base_url == referenced_base_url, "Referenced base_url should match original"
    
    print(f"  User (original)        : {user_name}")
    print(f"  User (referenced)      : {referenced_user}")
    assert user_name == referenced_user, "Referenced user should match original"
    
    print(f"  Port (original)        : {random_values['port']}")
    print(f"  Port (referenced)      : {referenced_port}")
    
    # Environment Variables
    print("\n[ENVIRONMENT VARIABLES]")
    {% if config.env_home and not config.env_home.startswith('<ENV_') %}
    env_home = "{{ config.env_home }}"
    print(f"  HOME : {env_home}")
    {% else %}
    print(f"  HOME : Not set or not available")
    {% endif %}
    
    {% if config.env_user and not config.env_user.startswith('<ENV_') %}
    env_user = "{{ config.env_user }}"
    print(f"  USER : {env_user}")
    {% else %}
    print(f"  USER : Not set or not available")
    {% endif %}
    
    # Test Metadata
    print("\n[TEST METADATA]")
    metadata = {
        "log_level": "{{ config.log_level }}",
        "environment": "{{ config.test_environment }}",
        "version": "{{ config.version }}",
        "total_configs": {{ config_metadata.total }},
        "required_configs": {{ config_metadata.required_count }},
        "optional_configs": {{ config_metadata.optional_count }},
        "secret_configs": {{ config_metadata.secret_count }}
    }
    
    for key, value in metadata.items():
        print(f"  {key:20} : {value}")
    
    # Summary Statistics
    print("\n[SUMMARY]")
    print(f"  Total configurations loaded: {{ config_metadata.total }}")
    print(f"  Configuration names: {{ config_metadata.all_names | length }} items")
    print(f"  Secrets detected: {{ config_metadata.secrets | join(', ') if config_metadata.secrets else 'None' }}")
    
    # Test Context Information
    print("\n[TEST CONTEXT]")
    print(f"  Test Name: {{ test_context.name }}")
    print(f"  Category: {{ test_context.category }}")
    print(f"  Description: {{ test_context.description[:50] }}...")
    
    # Validation Summary
    print("\n" + "=" * 80)
    print("ALL DIRECTIVE TESTS PASSED!")
    print(f"Session ID: {session_id}")
    print(f"Completed at: {datetime.now().isoformat()}")
    print("=" * 80)
    
    return True